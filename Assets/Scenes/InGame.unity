--- !u!114 &1343406172
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1343406170}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ecb0e9ab6513a5469a4ce6350870043, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  btnList:
  - {fileID: 1522843683}
  - {fileID: 1829361058}
  tmp_Text: {fileID: 1939189599}
  message:
  - "Ph\u01B0\u01A1ng tr\xECnh h\xF3a h\u1ECDc:\n2CuO <sup>t\xB0</sup>\u2192 2Cu
    + O<sub>2</sub>\n2H<sub>2</sub> + O<sub>2</sub> <sup>t\xB0</sup>\u2192 2H<sub>2</sub>O\nBaCl<sub>2</sub>
    + Na<sub>2</sub>SO<sub>4</sub> \u2192 BaSO<sub>4</sub>\u2193 + 2NaCl\nCH<sub>3</sub>COOH
    \u21CC CH<sub>3</sub>COO<sup>-</sup> + H<sup>+</sup>\n"
  - "Gi\xE1o s\u01B0 Tr\u1EA7n \u0110\u1EA1i Ngh\u0129a\n- K\u1EF9 s\u01B0 qu\xE2n
    s\u1EF1, Anh h\xF9ng Lao \u0111\u1ED9ng Vi\u1EC7t Nam\n- Ng\u01B0\u1EDDi \u0111\u1EB7t
    n\u1EC1n m\xF3ng cho C\xF4ng nghi\u1EC7p qu\u1ED1c ph\xF2ng Vi\u1EC7t Nam \n-
    Th\u01B0\u1EDDng xu\u1EA5t hi\u1EC7n v\u1EDBi c\u1EB7p k\xEDnh"
  - "Gi\xE1o s\u01B0 T\u1EA1 Quang B\u1EEDu\n- Nguy\xEAn B\u1ED9 tr\u01B0\u1EDFng
    B\u1ED9 Qu\u1ED1c ph\xF2ng v\xE0 B\u1ED9 \u0110\u1EA1i h\u1ECDc v\xE0 Trung h\u1ECDc
    Chuy\xEAn nghi\u1EC7p Vi\u1EC7t Nam\n- T\xE1c gi\u1EA3 cu\u1ED1n s\xE1ch \u0111\u1EA7u
    ti\xEAn v\u1EC1 x\xE1c su\u1EA5t th\u1ED1ng k\xEA b\u1EB1ng ti\u1EBFng Vi\u1EC7t\n-
    Mang v\u1EBB m\u1EB7t hi\u1EC1n t\u1EEB"
  - "Phi c\xF4ng V\u0169 Xu\xE2n Thi\u1EC1u\n- C\u1EF1u sinh vi\xEAn \u0111\u1EA1i
    h\u1ECDc BKHN, Th\u01B0\u1EE3ng \xFAy qu\xE2n \u0111\u1ED9i \n- Hy sinh khi tham
    gia chi\u1EBFn d\u1ECBch \u0110i\u1EC7n Bi\xEAn Ph\u1EE7 tr\xEAn kh\xF4ng"
  - "K\u1EF9 s\u01B0 Nguy\u1EC5n H\xE0 \u0110\xF4ng\n- C\u1EF1u sinh vi\xEAn \u0111\u1EA1i
    h\u1ECDc BKHN\n- T\xE1c gi\u1EA3 tr\xF2 ch\u01A1i Flappy Bird\n- Mang khu\xF4n
    m\u1EB7t kh\xE1 gi\u1ED1ng Nam Cao, \"kh\xF4ng ch\u01A1i \u0111\u01B0\u1EE3c\" "
  - "Qu\xEAn m\u1EADt kh\u1EA9u?\nHai anh, c\u0169ng S\u1ED0 m\xE1, n\xEC!\r\nTr\xE1i
    th\xEC xem x\xE9t, ph\u1EA3i th\xEC b\u1ECF qua\r\nAnh th\xEC c\xF4 \u0111\u1ED9c
    m\xECnh ta\r\nThu\u1EADn v\u1EADy coi x\xE9t, ch\u1EB3ng m\xE0ng tr\u1ECDng khinh\r\n\n"
